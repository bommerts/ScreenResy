<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Built as a console-subsystem app on purpose, so shells wait for it and stdout, stderr and
      exit codes work normally. app.manifest tells Windows not to open a console window when the
      app is started from Explorer or a shortcut.
    -->
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>2.0.0</Version>
    <Product>ScreenResy</Product>
    <Description>Change screen resolution, refresh rate and scale from a window or the command line.</Description>
    <Authors>Joe Farrell</Authors>
    <Company>Joe Farrell</Company>
    <Copyright>Copyright (C) 2023-2026 Joe Farrell</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
